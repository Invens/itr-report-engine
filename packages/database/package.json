{
  "name": "@itr/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "format": "prisma format --schema prisma/schema.prisma",
    "validate": "prisma validate --schema prisma/schema.prisma",
    "build": "prisma validate --schema prisma/schema.prisma",
    "typecheck": "prisma validate --schema prisma/schema.prisma",
    "test": "prisma validate --schema prisma/schema.prisma",
    "lint": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.16.1"
  },
  "devDependencies": {
    "prisma": "6.16.1"
  }
}
