# Copy to .env for repeatable starts, or run: DEEPSEEK_API_KEY=your-key sh ./start.sh
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

APP_PORT=3000
WEB_URL=http://localhost:3000
MAX_UPLOAD_MB=25
MAX_BUNDLE_FILES=100
OCR_MAX_PAGES=25
OCR_DPI=200

POSTGRES_DB=itr
POSTGRES_USER=itr
# Generated automatically by start.sh and stored only in the ignored .env file.
POSTGRES_PASSWORD=
